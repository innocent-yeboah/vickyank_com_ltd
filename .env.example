# VickYank Limited — environment template
# Copy to .env.local and fill in values before production deploy.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (Ghana GHS)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Optional: Flutterwave
# FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
# FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxx

# Resend — email notifications for enquiries
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=VickYank Website <onboarding@resend.dev>

# Optional: Supabase — persists form enquiries
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
